{
  "name": "mrkwiz",
  "version": "1.0.0",
  "description": "A small anonymous quiz app for measuring relationship/play-style traits.",
  "type": "module",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:functions": "vitest run -c vitest.functions.config.ts",
    "test:smoke:api": "vitest run -c vitest.smoke.config.ts",
    "test:smoke:api:staging": "vitest run -c vitest.smoke.config.ts tests/smoke/deployment-api-smoke.test.ts",
    "test:db:safe": "bash ./scripts/test-with-db-backup.sh",
    "test:db:safe:keep-backup": "bash ./scripts/test-with-db-backup.sh --keep-backup",
    "serve": "vite preview",
    "create:admin-quiz": "tsx scripts/create-admin-quiz.ts",
    "deploy": "wrangler publish",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "docs:schemas": "tsx scripts/generate-schema-docs.ts",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "supabase:db:reset": "supabase db reset",
    "supabase:migration:new": "supabase migration new",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "mustache": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "supabase": "^2.101.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "wrangler": "^4.94.0"
  },
  "keywords": [
    "quiz",
    "react",
    "vite",
    "typescript",
    "supabase",
    "cloudflare"
  ],
  "author": "Your Name",
  "license": "MIT"
}